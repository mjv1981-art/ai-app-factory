# Configure through hosting/Actions secret settings. Never commit real values.
FACTORY_ORIGIN=https://your-factory.example
FACTORY_OWNER=your-github-login
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Generate 32 random bytes as 64 hex characters; retain securely across deployments.
SESSION_ENCRYPTION_KEY=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Optional, separate owner credential for explicit private repository creation.
GITHUB_REPOSITORY_CREATION_TOKEN=
# Private repository containing the trusted, pinned factory-worker workflow.
FACTORY_RUNNER_REPOSITORY=your-github-login/private-factory-runs
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Match the target project's installed Playwright version. Pin digest for deployment.
FACTORY_BUILD_IMAGE=mcr.microsoft.com/playwright:v1.63.0-noble
# Restricted dependency-download network, configured by the trusted runner workflow.
FACTORY_BUILD_NETWORK=factory-dependencies
# Optional private S3-compatible object storage. Without it pilot evidence is bounded to 25 MB in Postgres.
ARTIFACT_BUCKET=
ARTIFACT_ENDPOINT=
ARTIFACT_REGION=auto
ARTIFACT_ACCESS_KEY=
ARTIFACT_SECRET_KEY=
